{
  "name": "senka-admin-test",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [{ "binding": "DB", "database_name": "senka-db", "database_id": "local" }],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "senka-media" }],
  "vars": { "ACCESS_TEAM_DOMAIN": "test.cloudflareaccess.com", "ACCESS_AUD": "test-aud" }
}

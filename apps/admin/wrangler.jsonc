{
  "name": "senka-admin",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "preview_urls": false,
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "senka-db", "database_id": "local", "migrations_dir": "../../migrations" }
  ],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "senka-media" }],
  "vars": { "ACCESS_TEAM_DOMAIN": "", "ACCESS_AUD": "" }
}

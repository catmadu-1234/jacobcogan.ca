---
import { env } from "cloudflare:workers";
import { listPublicWorks } from "@senka/core";
import Gallery from "../../../layouts/Gallery.astro";
import { collectTags } from "../../../lib/tags";
import { describe, siteForPage } from "../../../lib/page";
import { IndexPage } from "../../../ui/IndexPage";

export const prerender = false;
const site = await siteForPage(Astro.locals.site, Astro.params.site, env.DB);
if (!site) return Astro.rewrite("/404");

const all = await listPublicWorks(env.DB, site, env.MEDIA_BASE);
const tags = collectTags(all);
const tag = tags.find((t) => t.slug === Astro.params.tag);
if (!tag) return Astro.rewrite("/404");
const works = all.filter((w) => w.tags.some((t) => t.slug === tag.slug));
---

<Gallery site={site} title={`${tag.name} — ${site.name}`} description={describe(site.about, `${tag.name} work by ${site.name}`)} image={works[0]?.cover?.src}>
  <IndexPage
    siteName={site.name}
    basePath={Astro.locals.basePath}
    works={works}
    tags={tags}
    activeTag={tag.slug}
    rowHeight={site.theme.rowHeight}
    showCaptions={site.theme.showIndexCaptions}
  />
</Gallery>

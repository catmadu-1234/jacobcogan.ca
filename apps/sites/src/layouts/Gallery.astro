---
import "@fontsource-variable/geist";
import "@fontsource-variable/geist-mono";
import "@fontsource-variable/instrument-sans";
import "@fontsource/instrument-serif/400.css";
import "@fontsource/instrument-serif/400-italic.css";
import geistFont from "@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url";
import instrumentSansFont from "@fontsource-variable/instrument-sans/files/instrument-sans-latin-wght-normal.woff2?url";
import instrumentSerifItalicFont from "@fontsource/instrument-serif/files/instrument-serif-latin-400-italic.woff2?url";
import "../styles/tokens.css";
import "../styles/gallery.css";
import "../styles/preset-grotesk.css";
import "../styles/preset-serif-title.css";
import { DEFAULT_THEME, type Site } from "@senka/core/types";
import { canonicalUrl } from "../lib/canonical";
import { themeStyle } from "../lib/style";
import viewerScript from "../scripts/viewer.js?raw";

interface Props {
  site?: Site;
  title: string;
  description?: string;
  /** A path or URL of an image for link previews. */
  image?: string | null;
  /** Adds the small script for the full-size viewer, arrow-key navigation and autoplaying short clips. */
  interactive?: boolean;
  noindex?: boolean;
}

const { site, title, description, image, interactive = false, noindex = false } = Astro.props;
const theme = site?.theme ?? DEFAULT_THEME;
const url = new URL(Astro.locals.publicUrl ?? Astro.request.url);
const preview = image ? new URL(image, url.origin).href : null;
const fonts = theme.preset === "serif-title" ? [instrumentSansFont, instrumentSerifItalicFont] : [geistFont];
---

<!doctype html>
<html lang="en" data-preset={theme.preset} style={themeStyle(theme)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description ? <meta name="description" content={description} /> : null}
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonicalUrl(url.href)} />}
    <link rel="icon" href="data:," />
    {fonts.map((href) => <link rel="preload" as="font" type="font/woff2" href={href} crossorigin />)}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    {description ? <meta property="og:description" content={description} /> : null}
    {preview ? <meta property="og:image" content={preview} /> : null}
    <meta name="twitter:card" content={preview ? "summary_large_image" : "summary"} />
  </head>
  <body>
    <slot />
    {interactive ? <script is:inline set:html={viewerScript} /> : null}
  </body>
</html>

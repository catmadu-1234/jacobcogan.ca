{
  "name": "senka-sites",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "./dist", "binding": "ASSETS" },
  "d1_databases": [
    { "binding": "DB", "database_name": "senka-db", "database_id": "d04a5e24-e001-4af3-9b12-25588eeabdb3", "migrations_dir": "../../migrations" }
  ],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "senka-media" }],
  "vars": { "MEDIA_BASE": "/media" }
}
